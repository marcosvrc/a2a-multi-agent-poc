{
  "name": "hotel-agent",
  "version": "0.1.0",
  "description": "Hotel Agent (LangGraph, TypeScript) — searches, filters and ranks hotels via MCP, exposed over A2A.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
