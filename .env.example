ENVIRONMENT=local
LOG_LEVEL=INFO
MOCK_MODE=true

OPENAI_API_KEY=

AWS_AGENT_ENABLED=false
MODEL_PROVIDER=ollama
OLLAMA_MODEL_ID=llama3.1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1

AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_BASE_SECONDS=0.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

OTEL_SERVICE_NAMESPACE=a2a-poc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

AUTH_MODE=dev
DEV_AGENT_TOKEN=local-development-only
JWT_SECRET=local-development-only-change-me
