ENVIRONMENT=local
LOG_LEVEL=INFO
MOCK_MODE=true

OPENAI_API_KEY=

# --- Caminhos guiados por LLM (opcionais — todo agente funciona sem isso, ADR-009/011/012) ---
# Flight Agent: só precisa de OPENAI_API_KEY acima (openai-agents já vem
# instalado na imagem por padrão, nenhuma outra variável necessária).
#
# Activity Agent (BeeAI) e Budget Agent (CrewAI): precisam de duas coisas
# além da variável abaixo — (1) rebuildar com o build arg correspondente
# (a dependência é pesada e não vem instalada por padrão):
#   INSTALL_BEEAI=true docker compose build activity-agent
#   INSTALL_CREWAI=true docker compose build budget-agent
# (2) o modelo apontado precisa existir de verdade. Com Ollama local
# (grátis, sem OPENAI_API_KEY): "ollama:llama3.1" para o Activity,
# "ollama/llama3.1" para o Budget (convenções diferentes de cada SDK) —
# e ajustar OLLAMA_API_BASE se o Ollama não estiver no container `ollama`
# do profile "aws" (Docker Desktop Mac/Windows, Ollama instalado direto
# na máquina: http://host.docker.internal:11434).
INSTALL_BEEAI=false
BEEAI_CHAT_MODEL=
INSTALL_CREWAI=false
CREWAI_LLM_MODEL=
OLLAMA_API_BASE=http://ollama:11434

AWS_AGENT_ENABLED=false
MODEL_PROVIDER=ollama
OLLAMA_MODEL_ID=llama3.1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1

AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_BASE_SECONDS=0.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

OTEL_SERVICE_NAMESPACE=a2a-poc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

AUTH_MODE=dev
DEV_AGENT_TOKEN=local-development-only
JWT_SECRET=local-development-only-change-me
